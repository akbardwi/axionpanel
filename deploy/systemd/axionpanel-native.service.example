# Native HTTPS profile. Review docs/native-tls-systemd.md before installation.
# 192.0.2.10 is a TEST-NET documentation address. Replace both occurrences in
# -addr and -origin with the operator-selected IP or DNS name and port.
[Unit]
Description=AxionPanel control panel (native HTTPS)
After=network-online.target axionpanel-agent.service
Wants=network-online.target axionpanel-agent.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
# No sd_notify. SIGTERM/SIGINT drain HTTP requests for up to 10 seconds.
Type=simple
User=axionpanel
Group=axionpanel
WorkingDirectory=/var/lib/axionpanel
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/local/axionpanel/bin/axionpanel \
    -addr 192.0.2.10:8443 \
    -origin https://192.0.2.10:8443 \
    -tls-cert /etc/axionpanel/tls/panel.crt \
    -tls-key /etc/axionpanel/tls/panel.key \
    -entrance-file /var/lib/axionpanel/entrance \
    -db /var/lib/axionpanel/panel.db \
    -secret-key /var/lib/axionpanel/secret.key \
    -agent-socket /run/axionpanel/agent.sock
StateDirectory=axionpanel
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=3s
TimeoutStopSec=15s
StandardOutput=journal
StandardError=journal

CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# /proc stays visible: the Go runtime inspects self, and stats pass through.

[Install]
WantedBy=multi-user.target
